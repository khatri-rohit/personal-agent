# Host-run agent app (apps/agent; copy to .env — gitignored). `agent` loads it itself.

# Cloud Ollama (chat / agent). Do not point at Compose for default workflow.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# Local Ollama daemon (UI "Local" mode: /api/tags discovery + chat).
# Default is fine when `ollama serve` is running on this machine.
# OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# System 1: fast local scorer for harness decisions (per-step thinking level).
# Unset URL = disabled; runs behave exactly as without it. Run state (task
# text, tool names) is sent to this URL, so keep it on this machine.
# OLLAMA_SYSTEMONE_URL=http://localhost:11434/v1/systemone
# SYSTEMONE_MODEL=nimble-v3:9b
# enforce (default): the thinking picker offers Auto; only Auto runs change.
# shadow: every run is scored and traced, nothing is applied, Auto is hidden.
# off: never called.
# SYSTEMONE_MODE=enforce
# SYSTEMONE_TIMEOUT_MS=5000
# 1 = also on Local-mode runs (shares the daemon's VRAM with the chat model)
# SYSTEMONE_WITH_LOCAL=0

# Title model for cloud runs (thinking is turned off when the model allows it).
# Optional default — overridable per host in Settings → Models.
# TITLE_MODEL=gemma4:cloud

# Sub-agent model roles (default: the parent's model). Pick models whose
# /api/show capabilities include "tools". Optional defaults — overridable
# per host in Settings → Models (file > env > run's model).
# AGENT_MODEL_FAST=
# AGENT_MODEL_STRONG=

# Summarizer model for sectioned compaction summaries (default: the run's
# model). Optional default — overridable in Settings → Models.
# AGENT_MODEL_SUMMARY=

# Harness feature flags ("name:on,name:off"). See README for the list.
# AGENT_FLAGS=

# Learning loop: idle time before a memory review runs (default 600000 ms).
# AGENT_LEARNING_IDLE_MS=600000

# Every model call's exact input and output is recorded for the eval viewer (thread blobs/). 0 turns it off.
# AGENT_RECORD_MODEL_CALLS=0

# Web search / fetch (optional). With no keys, clone uses Firecrawl keyless
# then Tavily keyless (shared rate limits). If OLLAMA_API_KEY is set, search
# uses Ollama cloud only. Optional keys raise limits for a single vendor:
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=

# Dev: pin the session catalog/ledger to this clone (gitignored).
# Unset → ~/.local/personal-assistant
# AGENT_HOME=.local/personal-assistant

# Voice add-ons. Providers say which backend exists; each reader still turns
# the feature on in Settings → Voice add-ons (both default OFF). Voice never
# sits on the run path: a missing backend only fails the voice request.
#
# The API is the single source of truth: the web reads these from
# GET /api/voice/capabilities (no VITE_ copies, no web rebuild).
#
# Voice STT provider:
#   browser  — Web Speech API (default; no Docker / Speaches)
#   speaches — local Speaches via POST /api/voice/transcribe
#   off      — hide voice input and its setting entirely
VOICE_STT_PROVIDER=browser

# Voice TTS provider — read-aloud "Listen" button:
#   browser  — speechSynthesis (default; no Docker / Speaches)
#   speaches — Kokoro via POST /api/voice/speak (browser voice if it fails)
#   off      — hide read-aloud and its setting entirely
VOICE_TTS_PROVIDER=browser

# Speaches only (VOICE_STT_PROVIDER=speaches + docker compose speaches)
SPEACHES_BASE_URL=http://127.0.0.1:8000
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-large-v3
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_STT_LANGUAGE=en
VOICE_STT_PROMPT=desk, Speaches, Nx monorepo, Ollama, agent-core, RunManager, ChatInput
# faster-whisper server-side Silero VAD (strips silence before decoding). Default true.
VOICE_STT_VAD_FILTER=true
# Browser Silero VAD assets (speaches provider only). Default: jsDelivr, version-matched.
# For offline use copy node_modules/@ricky0123/vad-web/dist/{vad.worklet.bundle.min.js,silero_vad_v5.onnx}
# and node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{mjs,wasm} to apps/web/public/vad/, then:
# VITE_VAD_ASSET_BASE=/vad/
# VITE_ORT_WASM_BASE=/vad/

# Speaches TTS only (VOICE_TTS_PROVIDER=speaches; install Kokoro per docker/README.md)
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX-fp16
VOICE_TTS_VOICE=af_heart
# 0.5–2.0
VOICE_TTS_SPEED=1
