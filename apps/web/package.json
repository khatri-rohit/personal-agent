{
  "name": "@agent/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.app.json --noEmit",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "executor": "@nx/eslint:lint",
        "options": {}
      },
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "@agent/agent"
            ],
            "target": "serve"
          }
        ]
      }
    },
    "projectType": "application",
    "sourceRoot": "apps/web/src",
    "tags": [
      "scope:web",
      "type:ui"
    ]
  },
  "dependencies": {
    "@agent/agent-client": "*",
    "@agent/agent-models": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.8",
    "@ricky0123/vad-web": "^0.0.31",
    "@streamdown/code": "^2.0.0",
    "@streamdown/mermaid": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "onnxruntime-web": "^1.31.1",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.9",
    "react-router": "^7.18.7",
    "streamdown": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5"
  }
}
