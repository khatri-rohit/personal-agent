{
  "name": "@agent/agent-service",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:agent",
      "type:service",
      "runtime:core"
    ],
    "targets": {
      "lint": { "executor": "@nx/eslint:lint", "options": {} },
      "test": {
        "options": {
          "command": "node scripts/run-vitest.mjs run"
        }
      }
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "openai": "^7.27.0",
    "@agent/agent-core": "*",
    "@agent/agent-models": "*"
  },
  "devDependencies": {}
}
